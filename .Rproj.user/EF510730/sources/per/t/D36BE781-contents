# -----------------------------------------------------------------------
## Tabla procesada a partir de un código:
# -----------------------------------------------------------------------
```{r, message=FALSE, warning=FALSE}
tabla_final <- rbind(tabla_bloque1, tabla_bloque2)

kable(tabla_final, digits = 4)

```
# -----------------------------------------------------------------------
# Elemento interactivo: Gráfica interactiva:
# -----------------------------------------------------------------------
```{r, message=FALSE, warning=FALSE}
library(ggplot2)

p2 <- ggplot(tabla_final, 
             aes(x = Tratamiento, y = Media_E, fill = Bloque)) +
  geom_bar(stat = "identity", position = "dodge") +
  theme_minimal() +
  labs(title = "Comparación de la tasa de transpiración (E) entre bloques",
       x = "Tratamiento",
       y = "Media de E (mmol H$_2$O m$^{-2}$ s$^{-1}$)")

print(p2)  # imprime la versión estática en el PDF

```
